# HTTP server
# LISTEN_ADDR 只对直接运行二进制生效；compose 固定容器内监听 :8080。
LISTEN_ADDR=:8080
TZ=Asia/Shanghai

# compose 发布端口：默认只监听回环，需要局域网/公网访问时改成 0.0.0.0 并在前面加 HTTPS 反代。
BIND_ADDR=127.0.0.1
HOST_PORT=8080

# Control-panel administrator (single user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Generate with: openssl rand -base64 48
APP_SECRET=replace-with-at-least-32-random-characters

# Telegram application credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-api-hash

# compose.yaml runs as the host user so ./data remains writable on Linux.
PUID=1000
PGID=1000
